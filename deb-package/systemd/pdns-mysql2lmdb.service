[Unit]
Description=PowerDNS MySQL to LMDB synchronizer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pdns
Group=pdns
EnvironmentFile=-/etc/default/pdns-mysql2lmdb
ExecStart=/usr/bin/pdns-mysql2lmdb $PDNS_MYSQL2LMDB_ARGS
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
